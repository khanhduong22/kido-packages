{
  "name": "@kido/geocoding-routing",
  "version": "1.0.0",
  "description": "Geocoding and routing engine, Haversine & Vincenty formulas, OSRM client with fallback, Vietnam airport hubs, tiered ride-booking fare calculator, geofencing, 4-layer anti-mock GPS, EXIF photo verifier, and B2B tier pricing guard",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/index.test.ts src/geo-guard/index.test.ts src/geo-guard/timezone-guard.test.ts"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
