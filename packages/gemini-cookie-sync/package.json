{
  "name": "@kido/gemini-cookie-sync",
  "version": "1.2.4",
  "description": "Chrome Extension & Client/Server Cookie Sync SDK for Google Gemini and ImageFX session maintenance",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js",
      "default": "./src/client.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js",
      "default": "./src/server.ts"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.mjs",
      "require": "./dist/constants.js",
      "default": "./src/constants.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/index.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
