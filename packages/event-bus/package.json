{
  "name": "@kido/event-bus",
  "version": "1.0.0",
  "description": "Production-grade Event Bus with Transactional Outbox, Idempotent Consumers, Dead Letter Queue (DLQ), and In-Memory / Redis Streams drivers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/index.test.ts"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  }
}
