{
  "name": "@kido/sitemap-incremental",
  "version": "1.0.0",
  "description": "High-performance Cold/Hot incremental sitemap generator with atomic writes, pre-gzip compression, and zero-downtime Nginx static serving",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
