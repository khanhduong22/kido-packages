{
  "name": "@kido/ai-stream",
  "version": "1.0.0",
  "description": "Tier-1 AI Token Streaming, Server-Sent Events (SSE), Fetch ReadableStream Consumer, Edge Buffer Flushing, RPM/TPM Rate Guard, Multi-Provider Fallback, 3-Tier RAG Pipeline, Cross-Encoder Reranker, Ingestion Pacing, Context Sanitizer, EDoS Quota Shield, Entity-Aware Semantic Cache & RAG Security Guard Suite",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./rpm-rate-guard": {
      "types": "./dist/rpm-rate-guard.d.ts",
      "import": "./dist/rpm-rate-guard.mjs",
      "require": "./dist/rpm-rate-guard.js",
      "default": "./src/rpm-rate-guard/index.ts"
    },
    "./rag-security-guard": {
      "types": "./dist/rag-security-guard.d.ts",
      "import": "./dist/rag-security-guard.mjs",
      "require": "./dist/rag-security-guard.js",
      "default": "./src/rag-security-guard/index.ts"
    },
    "./provider-fallback": {
      "types": "./dist/provider-fallback.d.ts",
      "import": "./dist/provider-fallback.mjs",
      "require": "./dist/provider-fallback.js",
      "default": "./src/provider-fallback/index.ts"
    },
    "./rag-pipeline": {
      "types": "./dist/rag-pipeline.d.ts",
      "import": "./dist/rag-pipeline.mjs",
      "require": "./dist/rag-pipeline.js",
      "default": "./src/rag-pipeline/index.ts"
    },
    "./quota-manager": {
      "types": "./dist/quota-manager.d.ts",
      "import": "./dist/quota-manager.mjs",
      "require": "./dist/quota-manager.js",
      "default": "./src/quota-manager/index.ts"
    },
    "./semantic-cache": {
      "types": "./dist/semantic-cache.d.ts",
      "import": "./dist/semantic-cache.mjs",
      "require": "./dist/semantic-cache.js",
      "default": "./src/semantic-cache/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/index.test.ts src/rag-security-guard/index.test.ts test/ai-stream.test.ts test/quota-manager.test.ts test/semantic-cache.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
